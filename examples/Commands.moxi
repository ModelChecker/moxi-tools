(set-logic UFLIA)
(declare-enum-sort A (a b c))
(declare-sort B 1)
(define-sort C (x) x)
(declare-const x (C A))
(declare-fun f1 (A) A)
(define-fun f2 ((x A)) A x)
(define-system S
    :input ((i Bool))
    :output ((o Bool))
    :local ((l0 Bool) (l1 Bool))
    :init o
    :trans (= o' i)
    :inv (= l0 true)
)
(define-system S_sub
    :input ((i Bool))
    :output ((o Bool))
    :local ((l Bool))
    :init o
    :trans (= o' i)
    :inv (= l true)
    :subsys (Subsys1 (S i o))
    :subsys (Subsys2 (S i l))
)
(check-system S_sub
    :input ((in Bool))
    :output ((out Bool))
    :local ((loc Bool))
    :assumption (a (= loc true))
    :fairness (f (= loc true))
    :reachable (r (= out true))
    :current (c (= out false))
    :query (q (a f r c))
    :queries ((q1 (a f r)) (q2 (a f r c)))
)